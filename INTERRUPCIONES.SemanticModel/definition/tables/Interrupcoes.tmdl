table Interrupcoes
	lineageTag: 63791d83-a694-4971-b9dc-83d496c2c176

	measure Cantidad_>1 =
			COALESCE(
			CALCULATE(
			    COUNTROWS('Interrupcoes'),
			    'Interrupcoes'[ColorAlarma] = "#FFFF66"
			),0)
		formatString: 0
		lineageTag: 1be251dc-cc39-41db-a493-9b570a7b87f5

	measure Cantidad_<1 =
			COALESCE(
			CALCULATE(
			    COUNTROWS('Interrupcoes'),
			    'Interrupcoes'[ColorAlarma] = "#FF4C4C"
			),0)
		formatString: 0
		lineageTag: 1379ff17-36b1-4047-b681-6f7cc54def10

	measure Cantidad_>2 =
			COALESCE(
			CALCULATE(
			    COUNTROWS('Interrupcoes'),
			    'Interrupcoes'[ColorAlarma] = "#FFFFFF"
			),0)
		formatString: 0
		lineageTag: 96defdde-5cdc-44f3-9ee6-fb401d88843d

	measure TotalMinutos = ```
			COALESCE(SUM('Interrupcoes'[Duracion_minutos]),0) 
			```
