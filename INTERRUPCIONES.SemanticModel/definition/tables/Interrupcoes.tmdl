	column Duracion_Segundos = DATEDIFF('Interrupcoes'[Inicio],'Interrupcoes'[Fim] , SECOND)
		formatString: 0
		lineageTag: a54c2952-d300-4459-8ca3-0035c7c35d28
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Duracion_horas =
			
			DATEDIFF('Interrupcoes'[Inicio], 'Interrupcoes'[Fim], HOUR)
		formatString: 0
		lineageTag: 31860059-de55-40a2-9743-298eb2becb1a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Ultimas_8H = ```
			
			VAR UltimoRegistro = MAX('Interrupcoes'[Inicio])
			RETURN 
			    IF(
			        'Interrupcoes'[Inicio] >= UltimoRegistro - (8 / 24),
			        1,
			        0
			    )
			```
		formatString: 0
		lineageTag: 853b01e2-19cd-470a-b2a5-a13680c8429a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ColorAlarma =
			VAR Minutos = DATEDIFF([Inicio], [Fim], MINUTE)
			RETURN
			SWITCH(TRUE(),
			    Minutos >= 0 && Minutos < 60, "#FF4C4C",      -- 🔴 Menos de 1 hora NOW()
			    Minutos >= 60 && Minutos < 121, "#FFFF66",    -- 🟡 Entre 1 y 2 horas
			    Minutos >= 121, "#FFFFFF",                    -- ⚪ Más de 2 horas
			    BLANK()
			)
		lineageTag: f4ac4eb5-85d0-4e1d-b3f3-a81690ffa1ab
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Duracion_minutos = DATEDIFF('Interrupcoes'[Inicio],'Interrupcoes'[Fim],MINUTE)
		formatString: 0
		lineageTag: ea430359-bc42-48c7-b99b-3a67346c181a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

